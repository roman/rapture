(use-package projectile
  :require (ripgrep rg)
  :diminish projectile-mode
  :init
  (when (file-directory-p "~/Projects")
    (setq projectile-project-search-path '("~/Projects")))
  :config 
  (projectile-mode)
  (evil-define-key 'normal 'projectile-mode-map (kbd "<SPC> p p") 'projectile-switch-project)
  (evil-define-key 'normal 'projectile-mode-map (kbd "<SPC> p k") 'projectile-kill-buffers)
  (evil-define-key 'normal 'projectile-mode-map (kbd "<SPC> p o") 'projectile-multi-occur)
  (evil-define-key 'normal 'projectile-mode-map (kbd "<SPC> p c") 'projectile-compile)
  (evil-define-key 'normal 'projectile-mode-map (kbd "<SPC> p u") 'projectile-run)
  (evil-define-key 'normal 'projectile-mode-map (kbd "<SPC> p f") 'projectile-find-file)
  
  ;; :bind-keymap
  ;; ("C-c p" . projectile-command-map)
  )

