(use-package golden-ratio
  :require (evil winum)
  :init
  (setq golden-ratio-auto-scale t)
  :config
  (golden-ratio-mode)
  (defadvice evil-window-right
     (after golden-ratio-resize-window)
     (golden-ratio) 
     nil)
  (defadvice evil-window-left
    (after golden-ratio-resize-window)
     (golden-ratio) 
     nil)
  (defadvice evil-window-up
    (after golden-ratio-resize-window)
     (golden-ratio) 
     nil)
  (defadvice evil-window-down
    (after golden-ratio-resize-window)
     (golden-ratio) 
     nil)
  (defadvice winum-select-window-by-number
      (after golden-ratio-resize-window)
    (golden-ratio) 
    nil)
  (ad-activate 'evil-window-up)
  (ad-activate 'evil-window-down)
  (ad-activate 'evil-window-left)
  (ad-activate 'evil-window-right)
  (ad-activate 'winum-select-window-by-number))

(use-package winum
  :config
  (winum-mode)
  (global-set-key (kbd "M-1") 'winum-select-window-1)
